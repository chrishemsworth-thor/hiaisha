{
  "name": "@hiaisha/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute hiaisha --remote --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute hiaisha --local --file=src/db/schema.sql",
    "db:reset": "wrangler d1 execute hiaisha --remote --file=src/db/reset.sql",
    "db:reset:local": "wrangler d1 execute hiaisha --local --file=src/db/reset.sql"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.60.0"
  }
}
