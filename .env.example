# ─────────────────────────────────────────────────────────────────────────────
# Hiaisha — Root .env.example
#
# Copy this file to .env.local (for local development) or configure the
# variables in your deployment platform.  Never commit real secrets to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Next.js frontend (apps/web) ──────────────────────────────────────────────

# Base URL of the Hono API worker (no trailing slash).
# In local dev this is typically the Wrangler dev server.
# In production, the Cloudflare Worker URL or your custom API domain.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public-facing URL of the Next.js app (used for canonical URLs, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
